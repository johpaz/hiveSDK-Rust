{
  "name": "@johpaz/hive-sdk-rust",
  "version": "0.1.0",
  "type": "module",
  "description": "Hive agent SDK powered by Rust (development preview)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johpaz/hiveSDK-Rust.git",
    "directory": "packages/npm"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "services.mjs",
    "queue.mjs",
    "goals.mjs",
    "secrets.mjs",
    "index.d.ts",
    "platform.mjs",
    "platforms.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "THIRD_PARTY_INVENTORY.json"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "optionalDependencies": {
    "@johpaz/hive-sdk-rust-linux-x64-gnu": "0.1.0",
    "@johpaz/hive-sdk-rust-linux-x64-musl": "0.1.0",
    "@johpaz/hive-sdk-rust-linux-arm64-gnu": "0.1.0",
    "@johpaz/hive-sdk-rust-darwin-x64": "0.1.0",
    "@johpaz/hive-sdk-rust-darwin-arm64": "0.1.0",
    "@johpaz/hive-sdk-rust-win32-x64-msvc": "0.1.0"
  }
}
